{
  "name": "deepseek-dopame",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare:harness": "corepack pnpm --dir vendor/harness install --frozen-lockfile && corepack pnpm --dir vendor/harness run build && npm run prepare:runtime",
    "dev": "acde dev --desktop dopame",
    "check": "acde check",
    "prepare:runtime": "node scripts/package-runtime.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:layout": "node scripts/verify-layout.mjs"
  },
  "devDependencies": {
    "vite": "^6.4.6",
    "ws": "^8.21.0"
  },
  "engines": {
    "node": ">=24"
  }
}
